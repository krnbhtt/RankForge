{
  "name": "rankforge-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "RankForge AI Monorepo — Autonomous E-commerce Diagnostic & Optimization Engine",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm --recursive run build",
    "dev": "pnpm --recursive --parallel run dev",
    "dev:web": "pnpm --filter @rankforge/web dev",
    "dev:worker": "pnpm --filter @rankforge/worker dev",
    "lint": "pnpm --recursive run lint",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "docs:api": "tsx packages/schema/scripts/generate-api-docs.ts"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^8.57.1",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
